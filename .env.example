# D'PACHE SAS — Hermes Agent Governance Console
# Environment variables template
# Copy to .env.local and fill in your values

# =============================================================================
# REQUIRED — Core API Keys
# =============================================================================

# Google Gemini API Key (backend) — Get from https://aistudio.google.com/
GEMINI_API_KEY="your-gemini-api-key-here"

# API Key for client (frontend) — Same as above, Vite exposes VITE_* vars to browser
VITE_HERMES_API_KEY="your-gemini-api-key-here"

# =============================================================================
# AUTHENTICATION — API Key Hashes (REQUIRED in production)
# =============================================================================
# Comma-separated SHA-256 hashes (hex) of authorized API keys
# Generate with: node -e "console.log(require('crypto').createHash('sha256').update('your-key').digest('hex'))"
# Example: AUTH_KEY_HASHES="a1b2c3d4...,e5f6g7h8..."
AUTH_KEY_HASHES=""

# Force authentication in development (default: false)
# In production, auth is ALWAYS required regardless of this setting
REQUIRE_AUTH="false"

# =============================================================================
# CORS — Allowed Origins
# =============================================================================
# Comma-separated list of allowed origins for CORS
# Development defaults: http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,http://127.0.0.1:3000
# Production: MUST be set to your actual domain(s)
ALLOWED_ORIGIN=""

# =============================================================================
# SERVER — Optional
# =============================================================================
# Server port (default: 3000)
PORT="3000"

# Node environment (development|production)
NODE_ENV="development"

# Log level for pino (trace|debug|info|warn|error|fatal)
LOG_LEVEL="info"

# =============================================================================
# DEVELOPMENT — Vite / Frontend
# =============================================================================
# App URL (injected by AI Studio in production)
APP_URL="http://localhost:3000"

# Disable HMR if needed
# DISABLE_HMR="true"